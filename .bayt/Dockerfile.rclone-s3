# generated from bayt.cue — do not edit
FROM rclone/rclone:1.71.0@sha256:fd635aecd9667ee3c3bf920d14118090d4f2a83a080c1fa77e0bafbd4587ca87 AS rclone-s3
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.rclone-s3.json ./.bayt/
ENTRYPOINT ["sh", "-c", "mkdir -p \"/data/$RCLONE_LOCAL_BUCKET\" && exec rclone serve s3 --addr=0.0.0.0:3900 --vfs-cache-mode=off /data"]

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS rclone-s3_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.rclone-s3.yaml .bayt/Dockerfile.rclone-s3 .bayt/bayt.rclone-s3.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS rclone-s3_bayt
COPY --from=rclone-s3_bayt_ctxs /monorepo /monorepo
