# generated from bayt.cue — do not edit
FROM libraries_mecha-database-image AS timer-check
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.timer-check.json ./.bayt/
ENTRYPOINT ["psql"]
CMD ["-X", "--set=ON_ERROR_STOP=1", "--single-transaction", "--file=/timer-check.sql"]
COPY <<'TIMERS' /timer-check.sql
DO $$ BEGIN
  IF EXISTS (SELECT FROM hybrid_apexrun_presence.instance i
    WHERE i.state->>'phase' IN ('visible') AND (i.state->>'until')::bigint > 0
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'apexrun_presence', 'row', jsonb_build_object('id', i.id::text)))) THEN
    RAISE EXCEPTION 'machine apexrun_presence has instances waiting on a deadline the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF EXISTS (SELECT FROM hybrid_apexrun_challenge.instance i
    WHERE i.state->>'phase' IN ('offered') AND (i.state->>'deadline')::bigint > 0
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'apexrun_challenge', 'row', jsonb_build_object('id', i.id::text)))) THEN
    RAISE EXCEPTION 'machine apexrun_challenge has instances waiting on a deadline the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF EXISTS (SELECT FROM hybrid_apexrun_duel.instance i
    WHERE i.state->>'phase' IN ('waiting', 'signalling', 'racing') AND (i.state->>'deadline')::bigint > 0
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'apexrun_duel', 'row', jsonb_build_object('id', i.id::text)))) THEN
    RAISE EXCEPTION 'machine apexrun_duel has instances waiting on a deadline the ticker was never given';
  END IF;
END $$;
TIMERS

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS timer-check_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.timer-check.yaml .bayt/Dockerfile.timer-check .bayt/bayt.timer-check.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=apexrun-database_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS timer-check_bayt
COPY --from=timer-check_bayt_ctxs /monorepo /monorepo
