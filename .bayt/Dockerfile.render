FROM denoland/deno:debian-2.9.7@sha256:fa335acdf6b72106eda2cb6a8cb5f4187e7630e357467489db4b2e7352d5e432 AS render
ARG BAYT_DIR
WORKDIR /render
COPY --chmod=755 --from=tarampampam/microcheck:1@sha256:79c187c05bfa67518078bf4db117771942fa8fe107dc79a905861c75ddf28dfa /bin/httpcheck /usr/local/bin/httpcheck
COPY --from=plugins_omnishell-runtime-image /interpreter /render/plugins/omnishell/interpreter
COPY --from=plugins_omnishell-runtime-image /server /render/plugins/omnishell/server
COPY --from=apexrun-served /served/shell/index.html /render/entry.html
COPY --parents shell/index.html shell/shell.css shell/boot.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/arena.html shell/screens/arena.css shell/handlers/lease.js shell/handlers/lobby.js shell/handlers/run.js shell/renderers/ending.js shell/renderers/run_time.js shell/renderers/stage.js shell/engines/apexrun.json shell/engines/sound.json shell/engine/art.js shell/engine/effects.js shell/engine/hud.js shell/engine/present.js shell/engine/prng.js shell/engine/renderer.js shell/engine/scatter.js shell/engine/scenery.js shell/engine/simulation.js shell/engine/stage_look.js ./
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.render.json ./.bayt/
CMD ["deno", "run", "--frozen", "--cached-only", "--config", "plugins/omnishell/server/deno.json", "--allow-net", "--allow-env", "--allow-read=/render", "plugins/omnishell/server/render.ts"]
RUN deno cache --frozen --config plugins/omnishell/server/deno.json plugins/omnishell/server/render.ts
HEALTHCHECK --interval=1s --timeout=5s --retries=30 --start-period=120s CMD ["httpcheck","http://127.0.0.1:8090/health"]

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS render_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents shell/index.html shell/shell.css shell/boot.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/arena.html shell/screens/arena.css shell/handlers/lease.js shell/handlers/lobby.js shell/handlers/run.js shell/renderers/ending.js shell/renderers/run_time.js shell/renderers/stage.js shell/engines/apexrun.json shell/engines/sound.json shell/engine/art.js shell/engine/effects.js shell/engine/hud.js shell/engine/present.js shell/engine/prng.js shell/engine/renderer.js shell/engine/scatter.js shell/engine/scenery.js shell/engine/simulation.js shell/engine/stage_look.js ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS render_srcs
COPY --from=render_ctxs /monorepo /monorepo

