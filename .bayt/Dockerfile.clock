# generated from bayt.cue — do not edit
FROM libraries_mecha-clock-image AS clock
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.clock.json ./.bayt/

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS clock_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.clock.yaml .bayt/Dockerfile.clock .bayt/bayt.clock.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=apexrun-ticker_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS clock_bayt
COPY --from=clock_bayt_ctxs /monorepo /monorepo
